{
    "name": "astro-rift",
    "type": "module",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "astro dev --port 4321",
        "build": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
        "build:cf": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
        "preview": "astro preview",
        "astro": "astro",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "type-check": "astro check",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.6",
        "@astrojs/mdx": "^4.3.13",
        "@astrojs/react": "^4.4.2",
        "@astrojs/rss": "^4.0.15",
        "@astrojs/sitemap": "^3.7.0",
        "@astrojs/vercel": "^9.0.4",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify-json/ph": "^1.2.2",
        "@tailwindcss/vite": "^4.2.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "astro": "^5.17.3",
        "astro-icon": "^1.1.5",
        "astro-pagefind": "^1.8.5",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "eslint-plugin-astro": "^1.6.0",
        "hastscript": "^9.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "reading-time": "^1.5.0",
        "remark-gfm": "^4.0.1",
        "sharp": "0.34.5",
        "typescript": "^5.9.3",
        "unist-util-visit": "^5.1.0",
        "vanilla-cookieconsent": "3.1.0"
    },
    "devDependencies": {
        "@eslint/css": "^0.14.1",
        "@eslint/js": "^9.39.3",
        "@eslint/json": "^0.14.0",
        "@eslint/markdown": "^7.5.1",
        "@iconify/react": "^6.0.2",
        "@playwright/test": "^1.58.2",
        "@types/hast": "^3.0.4",
        "eslint": "^9.39.3",
        "eslint-config-xo": "^0.49.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "lint-staged": "^16.2.7",
        "prettier": "^3.8.1",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "shiki": "^3.22.0",
        "typescript-eslint": "^8.56.1",
        "vite": "^6.4.1"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,mdx}": [
            "prettier --write"
        ]
    },
    "resolutions": {
        "@emmetio/css-parser": "0.4.1"
    },
    "packageManager": "yarn@4.12.0"
}
