---
import Header from '@/components/nav/Header.astro';
import Footer from '@/components/nav/Footer.astro';
import BaseHead from '@/components/nav/BaseHead.astro';
import { Icon } from 'astro-icon/components';
import { SITE_LANG } from '@/consts.ts';

const title = '404 - Pagina non trovata';
const description = 'La pagina che stai cercando non esiste.';
---

<!doctype html>
<html lang=`${SITE_LANG}`>
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body>
        <Header />
        <div class="container flex min-h-[60vh] flex-col items-center justify-center py-12">
            <div class="error-404 flex flex-col items-center text-center">
                <h1 class="mb-6 flex items-center gap-3 font-bold">
                    <span class="mt-6 text-7xl">4</span>
                    <Icon
                        name="mdi:cancel"
                        class="text-primary h-20 w-20 text-8xl md:h-28 md:w-28 md:text-9xl"
                    />
                    <span class="mt-6 text-7xl">4</span>
                </h1>
                <h2
                    class="mb-4 text-2xl font-semibold text-gray-800 md:text-3xl dark:text-gray-200"
                >
                    Oops! Not found
                </h2>
                <p class="mb-8 text-base text-gray-600 md:text-lg dark:text-gray-400">
                    The page you've been looking for doesn't seem to exist
                </p>
                <button
                    onclick="history.back()"
                    class="bg-primary hover:bg-accent cursor-pointer rounded-lg px-6 py-3 text-white transition-colors"
                >
                    Go Back
                </button>
            </div>
        </div>
        <Footer />
    </body>
</html>

<style>
    .error-404 {
        max-width: 600px;
        margin: 0 auto;
    }

    .error-404 h1 {
        animation: fadeIn 0.6s ease-in;
    }

    .error-404 h2,
    .error-404 p {
        animation: fadeIn 0.8s ease-in;
    }

    .error-404 button {
        animation: fadeIn 1s ease-in;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .error-404 button:active {
        transform: scale(0.95);
    }
</style>
