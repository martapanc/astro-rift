---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '@/assets/fallback-image.jpg';
import { SITE_LANG, SITE_TITLE } from '@/consts.ts';

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    ogType?: 'website' | 'article';
    locale?: string;
    publishedTime?: Date | string;
    modifiedTime?: Date | string;
    author?: string;
    section?: string;
    tags?: string[];
    twitterSite?: string;
    twitterCreator?: string;
    robots?: string;
    jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
    title,
    description,
    image = FallbackImage,
    ogType = 'website',
    locale = SITE_LANG,
    publishedTime,
    modifiedTime,
    author,
    section,
    tags,
    twitterSite,
    twitterCreator,
    robots = 'index,follow',
    jsonLd,
} = Astro.props;

const imageUrl = new URL(image.src, Astro.site ?? Astro.url);
const toIsoString = (value?: Date | string) => {
    if (!value) return undefined;
    return typeof value === 'string' ? new Date(value).toISOString() : value.toISOString();
};
const publishedTimeIso = toIsoString(publishedTime);
const modifiedTimeIso = toIsoString(modifiedTime);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
    rel="alternate"
    type="application/rss+xml"
    title={SITE_TITLE}
    href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Preload fonts -->
<link rel="preload" href="/fonts/DMSerifText.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/markazi-text.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Quicksand.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/rubik-400.woff" as="font" type="font/woff" crossorigin />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={robots} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={locale} />

{
    ogType === 'article' && (
        <>
            {publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
            {modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
            {author && <meta property="article:author" content={author} />}
            {section && <meta property="article:section" content={section} />}
            {tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
    )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
{twitterSite && <meta property="twitter:site" content={twitterSite} />}
{twitterCreator && <meta property="twitter:creator" content={twitterCreator} />}

{
    jsonLd && (
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    )
}

<!-- Dark mode script - runs before page render to prevent flash -->
<script is:inline>
    (function () {
        const theme = localStorage.getItem('theme') || 'light';
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        }
    })();
</script>

<!-- Iconify for icon support in blockquotes -->
<script src="https://code.iconify.design/3/3.1.0/iconify.min.js" is:inline></script>

<!-- Cloudflare Web Analytics -->
{
    import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN}"}`}
        />
    )
}
