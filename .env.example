
# Resend Email Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# The email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com
# Your email address where contact form submissions will be sent
RESEND_TO_EMAIL=your-email@example.com

# Cloudflare Web Analytics
# Get your token from Cloudflare Dashboard > Analytics & Logs > Web Analytics
# https://dash.cloudflare.com/?to=/:account/web-analytics
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your_cloudflare_beacon_token

# Sentry Error Tracking
# Get your DSN from Sentry Dashboard > Project Settings > Client Keys
# https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# Note: PUBLIC_ prefix is required for client-side error tracking
PUBLIC_SENTRY_DSN=https://your_key@o123456.ingest.sentry.io/1234567
SENTRY_PROJECT=your-project-name
# Get auth token from Sentry > Settings > Auth Tokens
# Required for source maps upload (can be omitted if not using source maps)
SENTRY_AUTH_TOKEN=your_sentry_auth_token
